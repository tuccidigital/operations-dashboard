table Data
	lineageTag: f852bb34-ed5d-5658-bbeb-7aadcb89d1b8
	dataCategory: Time

	column Data
		dataType: dateTime
		isKey
		formatString: dd/mm/yyyy
		lineageTag: a418ba42-7ecc-5e7f-8b61-276f68b155f1
		summarizeBy: none
		sourceColumn: [Date]

	column Ano
		dataType: int64
		formatString: 0
		lineageTag: 0dd458e4-c9e4-5e55-a412-f4241f5778cf
		summarizeBy: none
		sourceColumn: [Ano]

	column MesNum
		dataType: int64
		formatString: 0
		lineageTag: 6035c1ca-c8da-50ed-b2cb-cfacc099949e
		summarizeBy: none
		sourceColumn: [MesNum]

	column Mes
		dataType: string
		lineageTag: 06dcf7ef-6e08-5f6e-8947-9f62a0271466
		summarizeBy: none
		sourceColumn: [Mes]
		sortByColumn: AnoMes

	column AnoMes
		dataType: int64
		formatString: 0
		lineageTag: 7b0a5f18-3c78-5458-9cf8-fc48ce65c8de
		summarizeBy: none
		sourceColumn: [AnoMes]

	column InicioSemana
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 8e1f5dd8-b242-519c-a969-22385fd54f38
		summarizeBy: none
		sourceColumn: [InicioSemana]

	column DiaUtil
		dataType: string
		lineageTag: e0e9eda9-003d-546b-b7fd-e8b5d189cab1
		summarizeBy: none
		sourceColumn: [DiaUtil]

	column Feriado = LOOKUPVALUE ( Feriado[Nome], Feriado[Data], Data[Data] )
		dataType: string
		lineageTag: 01a07858-5254-5886-96ed-92d4c7c3f6aa
		summarizeBy: none

	column Ultimas12Semanas =
			VAR Ref = MAX ( ProducaoDiaria[Data] )
			RETURN IF ( Data[Data] > Ref - 84 && Data[Data] <= Ref, "Sim", "Não" )
		dataType: string
		lineageTag: 23e2dc14-b6db-5710-854f-d5567e6c8d19
		summarizeBy: none

	partition Data = calculated
		mode: import
		source =
				VAR Inicio = DATE ( YEAR ( MIN ( Solicitacoes[DataCriacaoDia] ) ), 1, 1 )
				VAR Fim = DATE ( YEAR ( MAX ( ProducaoDiaria[Data] ) ), 12, 31 )
				RETURN
				    ADDCOLUMNS (
				        CALENDAR ( Inicio, Fim ),
				        "Ano", YEAR ( [Date] ),
				        "MesNum", MONTH ( [Date] ),
				        "Mes", FORMAT ( [Date], "mmm/yy" ),
				        "AnoMes", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				        "InicioSemana", [Date] - WEEKDAY ( [Date], 2 ) + 1,
				        "DiaUtil", IF ( WEEKDAY ( [Date], 2 ) <= 5, "Sim", "Não" )
				    )

