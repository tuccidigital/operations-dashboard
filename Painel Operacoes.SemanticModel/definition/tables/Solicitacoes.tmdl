		summarizeBy: none
		sourceColumn: Atrasada

	column DataCriacaoDia
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 3ae7872f-101c-50b3-b931-49d1a9470ce1
		summarizeBy: none
		sourceColumn: DataCriacaoDia
		annotation UnderlyingDateTimeDataType = Date


	column HorasTotais
		dataType: double
		formatString: 0.0
		lineageTag: 2f0282eb-b4f8-55a0-b108-fd4b34ad7a12
		summarizeBy: none
		sourceColumn: HorasTotais

	partition Solicitacoes = m
		mode: import
		source =
				let
				    Origem = if Fonte = "CSV" then LerCsv("solicitacoes.csv") else error "A fonte Online entra na fase 2, com o tenant da Tucci.",
				    Tipado = Table.TransformColumnTypes(Origem, {{"Id", type text}, {"Codigo", type text}, {"Tipo", type text}, {"SolicitanteId", type text}, {"CentroCusto", type text}, {"FornecedorId", type text}, {"ValorTotal", Currency.Type}, {"Urgente", type text}, {"Status", type text}, {"DataCriacao", type datetime}, {"DataConclusao", type datetime}, {"TotalEtapas", Int64.Type}, {"Atrasada", type text}}, "en-US"),
				    Derivada1 = Table.AddColumn(Tipado, "DataCriacaoDia", each Date.From([DataCriacao]), type date),
				    Derivada2 = Table.AddColumn(Derivada1, "HorasTotais", each if [DataConclusao] = null then null else Duration.TotalHours([DataConclusao] - [DataCriacao]), type number)
				in
				    Derivada2

