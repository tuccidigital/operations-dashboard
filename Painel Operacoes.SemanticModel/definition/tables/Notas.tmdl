	partition Notas = m
		mode: import
		source =
				let
				    Origem = if Fonte = "CSV" then LerCsv("notas.csv") else error "A fonte Online entra na fase 2, com o tenant da Tucci.",
				    Tipado = Table.TransformColumnTypes(Origem, {{"ChaveAcesso", type text}, {"Numero", Int64.Type}, {"Serie", Int64.Type}, {"DataEmissao", type date}, {"FornecedorId", type text}, {"ValorTotal", Currency.Type}, {"SolicitacaoId", type text}, {"ValorPedido", Currency.Type}, {"Resultado", type text}, {"Motivo", type text}, {"StatusLancamento", type text}}, "en-US")
				in
				    Tipado

