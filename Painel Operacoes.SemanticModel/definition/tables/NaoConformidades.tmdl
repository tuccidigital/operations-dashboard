		summarizeBy: none
		sourceColumn: DiasParaFechar

	partition NaoConformidades = m
		mode: import
		source =
				let
				    Origem = if Fonte = "CSV" then LerCsv("nao_conformidades.csv") else error "A fonte Online entra na fase 2, com o tenant da Tucci.",
				    Tipado = Table.TransformColumnTypes(Origem, {{"Id", type text}, {"InspecaoId", type text}, {"AtivoCodigo", type text}, {"Severidade", type text}, {"Estado", type text}, {"Abertura", type datetime}, {"Prazo", type datetime}, {"Fechamento", type datetime}, {"ResponsavelId", type text}}, "en-US"),
				    Derivada1 = Table.AddColumn(Tipado, "AberturaDia", each Date.From([Abertura]), type date),
				    Derivada2 = Table.AddColumn(Derivada1, "DiasParaFechar", each if [Fechamento] = null then null else Duration.TotalDays([Fechamento] - [Abertura]), type number)
				in
				    Derivada2

