	partition Ativo = m
		mode: import
		source =
				let
				    Origem = if Fonte = "CSV" then LerCsv("ativos.csv") else error "A fonte Online entra na fase 2, com o tenant da Tucci.",
				    Tipado = Table.TransformColumnTypes(Origem, {{"Codigo", type text}, {"Nome", type text}, {"Tipo", type text}, {"Area", type text}}, "en-US")
				in
				    Tipado

